NODE_ENV=production
PORT=5000
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_DATABASE_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Comma-separated frontend origins. Do not add a trailing slash.
CLIENT_ORIGINS=https://etef.vercel.app,https://www.your-etef-domain.com
DB_POOL_MAX=5
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=5242880
TRUST_PROXY=true

# Password-reset email delivery: use Resend OR SMTP over TLS on port 465.
CLIENT_RESET_URL=https://etef.vercel.app/admin/reset-password
# RESEND_API_KEY=re_xxxxxxxxx
# MAIL_FROM=ETEF <no-reply@your-domain.com>
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=465
# SMTP_USER=no-reply@your-domain.com
# SMTP_PASS=your-app-password
